<!DOCTYPE html>
<html lang="pt-br">
<head>
    <meta charset="UTF-8">
    <title>Login Admin</title>

    <!-- AdminLTE -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/admin-lte@3.2/dist/css/adminlte.min.css">
</head>

<body class="hold-transition login-page">

<div class="login-box">
    <div class="login-logo">
        <b>Admin</b>LTE
    </div>

    <div class="card">
        <div class="card-body login-card-body">
            <p class="login-box-msg">Faça login</p>

            <form method="post" action="{{ base_path() }}/admin/login">
                <div class="input-group mb-3">
                    <input
                        type="email"
                        name="email"
                        class="form-control"
                        placeholder="E-mail"
                        required
                    >
                </div>

                <div class="input-group mb-3">
                    <input
                        type="password"
                        name="password"
                        class="form-control"
                        placeholder="Senha"
                        required
                    >
                </div>

                <button type="submit" class="btn btn-primary btn-block">
                    Entrar
                </button>
            </form>

            <br>

            <!-- LINK ESQUECEU A SENHA -->
            <p class="mb-1">
                <a href="{{ base_path() }}/admin/forgot">
                    Esqueceu a senha?
                </a>
            </p>

        </div>
    </div>
</div>

</body>
</html>
