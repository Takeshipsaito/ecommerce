{% extends "admin/layout.twig" %}

{% block content %}
<div class="card">
    <div class="card-header">
        <h3 class="card-title">Editar Categoria</h3>
        <a href="/ecommerce/public/admin/categories" class="btn btn-secondary float-right">
            Voltar
        </a>
    </div>

    <div class="card-body">
        <form action="/ecommerce/public/admin/categories/{{ category.idcategory }}/edit" method="post">
            <div class="form-group">
                <label for="descategory">Nome da Categoria</label>
                <input type="text" class="form-control" id="descategory" name="descategory" value="{{ category.descategory }}" required>
            </div>

            <div class="form-group mt-3">
                <button type="submit" class="btn btn-success">
                    Salvar Alterações
                </button>
                <a href="/ecommerce/public/admin/categories" class="btn btn-secondary">
                    Cancelar
                </a>
            </div>
        </form>
    </div>
</div>
{% endblock %}
