{% extends "admin/layout.twig" %}

{% block content %}
<div class="card">
    <div class="card-header">
        <h3 class="card-title">Categorias</h3>
        <a href="/ecommerce/public/admin/categories/create" class="btn btn-success float-right">
            Nova Categoria
        </a>
    </div>

    <div class="card-body">
        <table class="table table-bordered">
            <thead>
                <tr>
                    <th style="width: 10px">#</th>
                    <th>Nome da Categoria</th>
                    <th style="width: 240px">Ações</th>
                </tr>
            </thead>
            <tbody>
                {% for category in categories %}
                    <tr>
                        <td>{{ loop.index }}</td>
                        <td>{{ category.descategory }}</td>
                        <td>
                            <a href="/ecommerce/public/admin/categories/{{ category.idcategory }}/edit"
                               class="btn btn-primary btn-xs">
                                <i class="fa fa-edit"></i> Editar
                            </a>

                            <a href="/ecommerce/public/admin/categories/{{ category.idcategory }}/delete"
                               onclick="return confirm('Deseja realmente excluir este registro?')"
                               class="btn btn-danger btn-xs">
                                <i class="fa fa-trash"></i> Excluir
                            </a>
                        </td>
                    </tr>
                {% else %}
                    <tr>
                        <td colspan="3" class="text-center">
                            Nenhuma categoria encontrada.
                        </td>
                    </tr>
                {% endfor %}
            </tbody>
        </table>
    </div>
</div>
{% endblock %}
