{% extends "admin/layout.twig" %}

{% block content %}
<div class="content-wrapper">
    <section class="content-header">
      <h1>Lista de Categorias</h1>
    </section>

    <section class="content">
      <div class="row">
        <div class="col-md-12">
          <div class="box box-primary">
            <div class="box-header">
              <a href="/ecommerce/public/admin/categories/create" class="btn btn-success">Cadastrar Categoria</a>
            </div>
            <div class="box-body no-padding">
              <table class="table table-striped">
                <thead>
                  <tr>
                    <th style="width: 10px">#</th>
                    <th>Nome da Categoria</th>
                    <th style="width: 240px">&nbsp;</th>
                  </tr>
                </thead>
                <tbody>
                  {% for category in categories %}
                  <tr>
                    <td>{{ category.idcategory }}</td>
                    <td>{{ category.descategory }}</td>
                    <td>
                      <a href="/ecommerce/public/admin/categories/{{ category.idcategory }}" class="btn btn-primary btn-xs"><i class="fa fa-edit"></i> Editar</a>
                      <a href="/ecommerce/public/admin/categories/{{ category.idcategory }}/delete" onclick="return confirm('Deseja realmente excluir?')" class="btn btn-danger btn-xs"><i class="fa fa-trash"></i> Excluir</a>
                    </td>
                  </tr>
                  {% else %}
                  <tr>
                    <td colspan="3" class="text-center">Nenhuma categoria encontrada.</td>
                  </tr>
                  {% endfor %}
                </tbody>
              </table>
            </div>
          </div>
        </div>
      </div>
    </section>
</div>
{% endblock %}