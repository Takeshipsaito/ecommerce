{% extends "admin/layout.twig" %}

{% block title %}Editar Usuário{% endblock %}

{% block content %}
<section class="content-header">
    <h1>Editar Usuário</h1>
</section>

<section class="content">
    <div class="card card-primary">
        <div class="card-body">

            <form method="post"
                  action="/ecommerce/public/admin/users/{{ user.iduser }}/edit">

                <input type="hidden"
                    name="deslogin"
                     value="{{ user.deslogin }}">


                <div class="form-group">
                    <label>Nome</label>
                    <input type="text"
                           name="desperson"
                           class="form-control"
                           value="{{ user.desperson }}"
                           required>
                </div>

                <div class="form-group">
                    <label>Telefone</label>
                    <input type="tel"
                           name="nrphone"
                           class="form-control"
                           value="{{ user.nrphone }}">
                </div>
                <div class="form-group">
                    <label>Login</label>
                    <input type="text"
                           name="deslogin"
                           class="form-control"
                           value="{{ user.deslogin }}"
                           required>
                </div>

                <div class="form-group">
                    <label>E-mail</label>
                    <input type="email"
                           name="desemail"
                           class="form-control"
                           value="{{ user.desemail }}"
                           required>
                </div>

                <div class="form-group">
                    <label>Senha</label>
                    <input type="password"
                           name="despassword"
                           class="form-control"
                           placeholder="Deixe em branco para não alterar">
                </div>

                <div class="form-check">
                    <input type="checkbox"
                           name="inadmin"
                           value="1"
                           {% if user.inadmin == 1 %}checked{% endif %}>
                    <label class="form-check-label">Administrador</label>
                </div>

                
                <br>

                <button type="submit" class="btn btn-primary">
                    Salvar
                </button>

                <a href="/ecommerce/public/admin/users" class="btn btn-secondary">
                    Voltar
                </a>

            </form>

        </div>
    </div>
</section>
{% endblock %}
